{
  "expo": {
    "name": "Onde Estacionei?",
    "slug": "onde-estacionei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.fatec.ondeestacionei"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "br.fatec.ondeestacionei"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O app usa sua localização para salvar onde você estacionou e guiar você de volta até o carro."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app usa a câmera para fotografar a vaga onde você estacionou.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}